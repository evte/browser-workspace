# ./deploy.sh up automatically creates .env with a random password; this file is a reference.
# Keep this project name stable: it selects the persistent browser_data volume.
COMPOSE_PROJECT_NAME=browser-workspace

# Use SSH tunneling or HTTPS reverse proxy; keep the backend on loopback by default.
BROWSER_BIND_ADDRESS=127.0.0.1
BROWSER_PORT=8000

# First-registration setup key, NOT an existing account's login password.
# If copying this file manually, generate a value with: openssl rand -hex 24
# It must be at least 12 characters. Never commit .env or share this key.
ACCESS_PASSWORD=
